alias ls='ls -lhG'
alias lsa='ls -lhGa'
alias cls='clear;ls;'
alias clsa='clear;lsa'
alias sl='ls'
alias gr='grep -rnI --color'
alias ssi='cd ~/workspace/ssi/$(/bin/ls ~/workspace/ssi | percol)'
alias code='cd ~/workspace'
alias cl='clear'
alias cjs='echo $2 | coffee -sc'
alias gpp='git pull; tig status; git commit; git push'
alias tgs='tig status'
alias vi='vim'
alias scan-network='nmap -PR -sP 192.168.0.1/24'
alias op='xdg-open'
alias kb='xset r rate 350 45 &; xmodmap -e "clear Lock"; xmodmap -e "keysym Caps_Lock = Escape"'
alias wls='watch -n 1 ls -lh'
alias ....='cd ../../../'
alias .....='cd ../../../../'
alias dmenu="dmenu_run -nb '#000000' -nf '#FFFFFF' -sb '#242424' -sf '#00bbbb'"
alias psg='ps aux | grep'
alias mongodlocal='mongod -f /usr/local/etc/mongod.conf'
alias redislocal='redis-server /usr/local/etc/redis.conf'
alias ping8='ping 8.8.8.8'
alias o='xdg-open'
